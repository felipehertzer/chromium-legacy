+// Compatibility adapters are linked by Chromium only for its Lion target.
+// FFI pointers retain the contracts of the corresponding libc functions.
+#[cfg(chromium_legacy_macos)]
+pub(crate) mod legacy_macos {
+    use libc::{c_char, c_int, clockid_t, mode_t, stat, timespec, DIR};
+    unsafe extern "C" {
+        #[link_name = "ChromiumLegacyRustClockGettime"]
+        pub fn clock_gettime(clock: clockid_t, result: *mut timespec) -> c_int;
+        #[link_name = "ChromiumLegacyRustRandom"]
+        pub fn random(output: *mut u8, size: usize);
+        #[link_name = "ChromiumLegacyRustOpenAt"]
+        fn openat_impl(parent: c_int, path: *const c_char, flags: c_int, mode: mode_t) -> c_int;
+        #[link_name = "ChromiumLegacyRustFstatAt"]
+        pub fn fstatat(parent: c_int, path: *const c_char, result: *mut stat, flags: c_int) -> c_int;
+        #[link_name = "ChromiumLegacyRustMkdirAt"]
+        pub fn mkdirat(parent: c_int, path: *const c_char, mode: mode_t) -> c_int;
+        #[link_name = "ChromiumLegacyRustUnlinkAt"]
+        pub fn unlinkat(parent: c_int, path: *const c_char, flags: c_int) -> c_int;
+        #[link_name = "ChromiumLegacyRustFdOpenDir"]
+        pub fn fdopendir(fd: c_int) -> *mut DIR;
+        #[link_name = "ChromiumLegacyRustDirFd"]
+        pub fn dirfd(directory: *mut DIR) -> c_int;
+        #[link_name = "ChromiumLegacyRustRenameAt"]
+        pub fn renameat(from_fd: c_int, from: *const c_char, to_fd: c_int, to: *const c_char) -> c_int;
+        #[link_name = "ChromiumLegacyRustFchmodAt"]
+        pub fn fchmodat(parent: c_int, path: *const c_char, mode: mode_t, flags: c_int) -> c_int;
+        #[link_name = "ChromiumLegacyRustLinkAt"]
+        pub fn linkat(from_fd: c_int, from: *const c_char, to_fd: c_int, to: *const c_char, flags: c_int) -> c_int;
+        #[link_name = "ChromiumLegacyRustFutimens"]
+        fn set_fd_times(fd: c_int, access: *const timespec, modified: *const timespec) -> c_int;
+        #[link_name = "ChromiumLegacyRustUtimensAt"]
+        fn set_path_times(parent: c_int, path: *const c_char, access: *const timespec, modified: *const timespec, flags: c_int) -> c_int;
+    }
+    pub unsafe fn openat(parent: c_int, path: *const c_char, flags: c_int, mode: c_int) -> c_int {
+        // libc's variadic openat promotes mode_t to int. Preserve that caller
+        // interface while the fixed C adapter accepts the actual mode_t ABI.
+        unsafe { openat_impl(parent, path, flags, mode as mode_t) }
+    }
+    pub unsafe fn openat_dir(parent: c_int, path: *const c_char, flags: c_int) -> c_int {
+        // O_CREAT is not used by the directory-removal caller.
+        unsafe { openat(parent, path, flags, 0) }
+    }
+    pub unsafe fn futimens(fd: c_int, times: *const timespec) -> c_int {
+        // libc's contract requires two readable timespecs, or a null pointer.
+        let modified = if times.is_null() { times } else { unsafe { times.add(1) } };
+        unsafe { set_fd_times(fd, times, modified) }
+    }
+    pub unsafe fn utimensat(parent: c_int, path: *const c_char, times: *const timespec, flags: c_int) -> c_int {
+        let modified = if times.is_null() { times } else { unsafe { times.add(1) } };
+        unsafe { set_path_times(parent, path, times, modified, flags) }
+    }
