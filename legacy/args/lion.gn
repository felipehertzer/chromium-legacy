# Experimental port settings. A generated build is not proof of Lion support.
# Keep warnings and link errors visible while auditing unavailable OS APIs.
target_os = "mac"
target_cpu = "x64"

# ARM build hosts execute the Intel snapshot tools through Rosetta.
v8_snapshot_toolchain = "//build/toolchain/mac:clang_x64"
is_debug = false
is_component_build = false
is_official_build = false
is_chrome_branded = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
use_custom_libcxx = true
use_remoteexec = false
use_siso = false
use_system_xcode = true
mac_deployment_target = "10.7"
mac_min_system_version = "10.7"
treat_warnings_as_errors = true
fatal_linker_warnings = true
legacy_build_rust_stdlib = true

# Keep the focused checks available after full-browser graph regeneration.
root_extra_deps = [
  "//legacy:base_probe",
  "//legacy:crubit_probe",
  "//legacy:runtime_probe",
  "//legacy:rust_probe",
  "//legacy:sdk_probe",
]
