import("//build/rust/rust_executable.gni")

source_set("platform_support") {
  sources = [
    "apple/accessibility.h",
    "apple/appearance.h",
    "apple/atomic_wait.h",
    "apple/audit_token.h",
    "apple/clock.h",
    "apple/core_bluetooth.h",
    "apple/cv_buffer.h",
    "apple/drawing_image.h",
    "apple/fd_io.h",
    "apple/file_times.h",
    "apple/file_type.h",
    "apple/font_cascade.h",
    "apple/http_header.h",
    "apple/localized_string.h",
    "apple/location.h",
    "apple/product_version.h",
    "apple/quarantine.h",
    "apple/remove_all.h",
    "apple/scoped_dispatch.h",
    "apple/secure_archive.h",
    "apple/simd_math.h",
    "apple/window.h",
  ]
}

if (is_mac) {
  source_set("cocoa_support") {
    sources = [
      "apple/sheet.h",
      "apple/sheet.mm",
      "apple/speech.h",
      "apple/speech.mm",
      "apple/weak_key_map.h",
      "apple/weak_key_map.mm",
    ]
    frameworks = [ "AppKit.framework" ]
  }

  rust_executable("rust_probe") {
    testonly = true
    crate_root = "tests/rust_probe.rs"
    sources = [ "tests/rust_probe.rs" ]
  }

  source_set("rust_support") {
    sources = [
      "apple/rust_posix.cc",
      "apple/rust_posix.h",
    ]
    deps = [ ":platform_support" ]
    frameworks = [ "Security.framework" ]
  }

  executable("accessibility_probe") {
    testonly = true
    sources = [ "tests/accessibility_probe.mm" ]
    deps = [
      "//base",
      "//ui/accessibility/platform",
    ]
    frameworks = [ "AppKit.framework" ]
  }

  executable("geolocation_probe") {
    testonly = true
    sources = [ "tests/geolocation_probe.mm" ]
    deps = [
      ":platform_support",
      "//base",
      "//net",
      "//services/device/public/cpp/geolocation",
    ]
    frameworks = [ "CoreLocation.framework" ]
  }

  executable("printing_probe") {
    testonly = true
    sources = [ "tests/printing_probe.cc" ]
    deps = [
      "//base",
      "//printing/backend",
    ]
  }

  executable("sensor_reading_probe") {
    testonly = true
    sources = [ "tests/sensor_reading_probe.cc" ]
    deps = [
      "//base",
      "//services/device/public/cpp/generic_sensor",
    ]
  }

  executable("property_list_probe") {
    testonly = true
    sources = [ "tests/property_list_probe.mm" ]
    deps = [ "//base" ]
  }

  executable("midi_packet_probe") {
    testonly = true
    sources = [ "tests/midi_packet_probe.cc" ]
    deps = [
      "//base",
      "//media/midi",
    ]
  }

  executable("memory_pressure_probe") {
    testonly = true
    sources = [ "tests/memory_pressure_probe.cc" ]
    deps = [
      "//base",
      "//components/memory_pressure",
    ]
  }

  executable("sdk_probe") {
    testonly = true
    sources = [ "tests/sdk_probe.mm" ]
    frameworks = [
      "CoreText.framework",
      "Foundation.framework",
    ]
  }

  executable("crubit_probe") {
    testonly = true
    sources = [ "tests/crubit_probe.cc" ]
    deps = [
      "//build/rust/tests/test_cpp_api_from_rust",
      "//testing/gtest",
    ]
  }

  executable("base_probe") {
    testonly = true
    sources = [ "tests/base_probe.cc" ]
    deps = [
      "//base",
      "//crypto",
    ]
  }

  executable("runtime_probe") {
    testonly = true
    sources = [ "tests/runtime_probe.cc" ]
    deps = [
      ":platform_support",
      ":rust_support",
      "//third_party/boringssl",
    ]
    frameworks = [ "CoreServices.framework" ]
    libs = [ "bsm" ]
  }
}
