import("//build/rust/rust_executable.gni")

source_set("platform_support") {
  sources = [
    "apple/atomic_wait.h",
    "apple/audit_token.h",
    "apple/clock.h",
    "apple/core_bluetooth.h",
    "apple/cv_buffer.h",
    "apple/fd_io.h",
    "apple/file_times.h",
    "apple/font_cascade.h",
    "apple/product_version.h",
    "apple/remove_all.h",
    "apple/scoped_dispatch.h",
  ]
}

if (is_mac) {
  rust_executable("rust_probe") {
    testonly = true
    crate_root = "tests/rust_probe.rs"
    sources = [ "tests/rust_probe.rs" ]
  }

  source_set("rust_support") {
    sources = [
      "apple/rust_posix.cc",
      "apple/rust_posix.h",
    ]
    deps = [ ":platform_support" ]
    frameworks = [ "Security.framework" ]
  }

  executable("sdk_probe") {
    testonly = true
    sources = [ "tests/sdk_probe.mm" ]
    frameworks = [
      "CoreText.framework",
      "Foundation.framework",
    ]
  }

  executable("crubit_probe") {
    testonly = true
    sources = [ "tests/crubit_probe.cc" ]
    deps = [
      "//build/rust/tests/test_cpp_api_from_rust",
      "//testing/gtest",
    ]
  }

  executable("base_probe") {
    testonly = true
    sources = [ "tests/base_probe.cc" ]
    deps = [
      "//base",
      "//crypto",
    ]
  }

  executable("runtime_probe") {
    testonly = true
    sources = [ "tests/runtime_probe.cc" ]
    deps = [
      ":platform_support",
      ":rust_support",
      "//third_party/boringssl",
    ]
    frameworks = [ "CoreServices.framework" ]
    libs = [ "bsm" ]
  }
}
